datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StaffRole {
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  ARTIST
}

enum SecurityEventType {
  LOGIN_ATTEMPT
  LOGIN_SUCCESS
  LOGIN_FAILED
  MFA_CHALLENGE
  MFA_SUCCESS
  MFA_FAILED
  RECOVERY_CODE_USED
  SESSION_REVOKED
  ROLE_CHANGED
  STAFF_DEACTIVATED
  PASSWORD_CHANGED
  INDEPENDENT_RECOVERY_REQUESTED
  INDEPENDENT_RECOVERY_APPROVED
  INDEPENDENT_RECOVERY_REJECTED
  SERVICE_CREATED
  TARIFF_UPDATED
  CONTRACT_PROPOSED
  CONTRACT_APPROVED
  CONTRACT_REJECTED
  SHIFT_CONFIGURED
  LEAVE_CONFIGURED
  RESOURCE_CONFIGURED
  SERVICE_PHASES_CONFIGURED
  SCHEDULE_RULE_CHANGED
  CAPACITY_CONFLICT_DETECTED
  CUSTOMER_OTP_REQUESTED
  CUSTOMER_OTP_VERIFIED
  CUSTOMER_OTP_FAILED
  CUSTOMER_LOGIN_SUCCESS
  CUSTOMER_SESSION_REVOKED
  CUSTOMER_UNAUTHORIZED_ACCESS_ATTEMPT
}

enum RecoveryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Staff {
  id           String    @id @default(uuid())
  username     String    @unique
  fullName     String
  phone        String?
  passwordHash String
  role         StaffRole
  isActive     Boolean   @default(true)
  mfaEnabled   Boolean   @default(true)
  mfaSecret    String?

  sessions          Session[]
  recoveryCodes     RecoveryCode[]
  auditLogs         AuditLog[]
  requestedRecoveries IndependentRecoveryRequest[] @relation("TargetStaff")
  approvedRecoveries  IndependentRecoveryRequest[] @relation("ApproverStaff")
  artistProfile     ArtistProfile?
  createdContracts  CommissionContract[]         @relation("ContractCreator")
  approvedContracts CommissionContract[]         @relation("ContractApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model Session {
  id        String    @id @default(uuid())
  staffId   String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, revokedAt])
}

model RecoveryCode {
  id        String    @id @default(uuid())
  staffId   String
  codeHash  String
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, usedAt, revokedAt])
}

model IndependentRecoveryRequest {
  id              String                @id @default(uuid())
  targetStaffId   String
  requesterNote   String
  status          RecoveryRequestStatus @default(PENDING)
  approverStaffId String?
  claimTokenHash  String?
  rejectionReason String?
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())

  targetStaff   Staff  @relation("TargetStaff", fields: [targetStaffId], references: [id], onDelete: Cascade)
  approverStaff Staff? @relation("ApproverStaff", fields: [approverStaffId], references: [id])

  @@index([targetStaffId, status])
}

model AuditLog {
  id         String            @id @default(uuid())
  staffId    String?
  customerId String?
  eventType  SecurityEventType
  details    Json?
  ipAddress  String?
  createdAt  DateTime          @default(now())

  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([staffId, eventType])
  @@index([customerId, eventType])
  @@index([createdAt])
}

enum ServicePriceType {
  FIXED
  RANGE
}

enum ArtistLevel {
  JUNIOR
  MID
  SENIOR
  MASTER
}

enum ContractStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUPERSEDED
}

model Service {
  id              String           @id @default(uuid())
  name            String
  description     String?
  priceType       ServicePriceType
  fixedPrice      Int?
  minPrice        Int?
  maxPrice        Int?
  fixedDeposit    Int?
  durationMinutes Int?
  requiresReview  Boolean          @default(false)
  isPublished     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tariffs  ArtistServiceTariff[]
  phases   ServicePhase[]
  bookings ServiceBooking[]

  @@index([isPublished])
}

model ArtistProfile {
  id              String      @id @default(uuid())
  staffId         String      @unique
  bio             String?
  experienceYears Int?
  level           ArtistLevel @default(SENIOR)
  portfolioUrls   String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  staff     Staff                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tariffs   ArtistServiceTariff[]
  contracts CommissionContract[]
  shifts    WorkingShift[]
  leaves    ArtistLeave[]
  bookings  ServiceBooking[]

  @@index([level])
}

model ArtistServiceTariff {
  id              String           @id @default(uuid())
  artistId        String
  serviceId       String
  priceType       ServicePriceType
  fixedPrice      Int?
  minPrice        Int?
  maxPrice        Int?
  fixedDeposit    Int?
  durationMinutes Int?
  version         Int              @default(1)
  isActive        Boolean          @default(true)
  validFrom       DateTime         @default(now())
  validTo         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  artist  ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([artistId, serviceId, isActive])
  @@index([serviceId, version])
}

model CommissionContract {
  id                 String         @id @default(uuid())
  artistId           String
  creatorStaffId     String
  approverStaffId    String?
  commissionRate     Float
  deductMaterialCost Boolean        @default(true)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  status             ContractStatus @default(PENDING_APPROVAL)
  rejectionReason    String?
  approvedAt         DateTime?
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  artist   ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  creator  Staff         @relation("ContractCreator", fields: [creatorStaffId], references: [id], onDelete: Cascade)
  approver Staff?        @relation("ContractApprover", fields: [approverStaffId], references: [id], onDelete: SetNull)

  @@index([artistId, status])
  @@index([artistId, effectiveFrom])
}

model SharedResource {
  id          String   @id @default(uuid())
  name        String
  capacity    Int      @default(1)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases      ServicePhase[]
  allocations ServiceBookingResourceAllocation[]

  @@index([isActive])
}

model ServicePhase {
  id                   String   @id @default(uuid())
  serviceId            String
  name                 String
  sequenceOrder        Int
  durationMinutes      Int
  isPause              Boolean  @default(false)
  resourceId           String?
  resourceUnits        Int      @default(1)
  setupBufferMinutes   Int      @default(0)
  cleanupBufferMinutes Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource SharedResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([serviceId, sequenceOrder])
}

model WorkingShift {
  id           String    @id @default(uuid())
  artistId     String
  dayOfWeek    Int       // 0 = Saturday, 1 = Sunday, ..., 6 = Friday (Persian calendar)
  startTime    String    // "09:00"
  endTime      String    // "18:00"
  isActive     Boolean   @default(true)
  specificDate DateTime? // Optional specific calendar date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, dayOfWeek, isActive])
  @@index([artistId, specificDate])
}

model ArtistLeave {
  id         String   @id @default(uuid())
  artistId   String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, startDate, endDate])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model ServiceBooking {
  id            String        @id @default(uuid())
  serviceId     String
  artistId      String
  customerName  String
  customerPhone String?
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(CONFIRMED)
  isImpacted    Boolean       @default(false)
  impactReason  String?
  customerId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  service     Service                            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  artist      ArtistProfile                      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  customer    Customer?                          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  allocations ServiceBookingResourceAllocation[]

  @@index([artistId, startTime, endTime])
  @@index([serviceId, startTime])
  @@index([customerId])
  @@index([status, isImpacted])
}

model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique
  fullName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  CustomerSession[]
  otpCodes  CustomerOtp[]
  auditLogs AuditLog[]
  bookings  ServiceBooking[]

  @@index([phone, isActive])
}

model CustomerOtp {
  id          String    @id @default(uuid())
  phone       String
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  usedAt      DateTime?
  customerId  String?
  createdAt   DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([phone, usedAt, expiresAt])
  @@index([phone, createdAt])
}

model CustomerSession {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, revokedAt])
}


model ServiceBookingResourceAllocation {
  id         String   @id @default(uuid())
  bookingId  String
  resourceId String
  phaseOrder Int
  startTime  DateTime
  endTime    DateTime
  unitsUsed  Int      @default(1)
  createdAt  DateTime @default(now())

  booking  ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource SharedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, startTime, endTime])
  @@index([bookingId])
}
